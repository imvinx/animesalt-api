# ==========================================
# AnimeSalt API & Web Player Environment Config
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# ==========================================
# Cloudflare Bypass / Scraper Proxy (Optional / Recommended for Vercel)
# ==========================================
# Cloudflare on animesalt.cx challenges serverless data-center IPs (AWS/Vercel).
# Use a free Cloudflare Worker reverse proxy (100,000 req/day free) to bypass it.
# See README.md for the 2-minute Worker setup guide.
#
# Format: https://your-worker-name.your-subdomain.workers.dev
PROXY_URL=

# Alternative rotating / commercial scraper proxy (e.g. ScraperAPI, Scrapfly, Webshare)
# Format: https://api.scraperapi.com?api_key=YOUR_API_KEY&url=
SCRAPER_PROXY=
